[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/crew_selection.gd" id="1_script"]
[ext_resource type="Theme" path="res://scenes/terminal_theme.tres" id="2_theme"]
[ext_resource type="Shader" path="res://shaders/crt_phosphor.gdshader" id="3_shader"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = ExtResource("3_shader")
shader_parameter/phosphor_color = Color(0.25, 1, 0.45, 1)
shader_parameter/scanline_count = 360.0
shader_parameter/scanline_intensity = 0.2
shader_parameter/curvature = 0.025
shader_parameter/vignette_intensity = 0.9
shader_parameter/glow_intensity = 0.15
shader_parameter/flicker_speed = 24.0
shader_parameter/flicker_intensity = 0.015

[node name="CrewSelection" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
