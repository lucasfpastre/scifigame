[ext_resource type="Shader" path="res://shaders/crt_phosphor.gdshader" id="3_shader"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = ExtResource("3_shader")
shader_parameter/phosphor_color = Color(0.25, 1, 0.45, 1)
